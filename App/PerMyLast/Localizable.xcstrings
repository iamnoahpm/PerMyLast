    "Not yet: it could not read your selection": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa được: chưa đọc được đoạn bạn bôi đen"
          }
        }
      }
    },
    "Per My Last only got what is on your clipboard. Allow access above, then select the text and press the shortcut again.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Per My Last chỉ lấy được nội dung trong clipboard. Hãy cấp quyền ở trên, rồi bôi đen đoạn văn và nhấn lại phím tắt."
          }
        }
      }
    },
    "Or try it in any other app. We will notice when it works.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoặc thử ở ứng dụng khác. Chúng tôi sẽ nhận ra khi nó hoạt động."
          }
        }
      }
    },
    "Connect Claude": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối Claude"
          }
        }
      }
    },
    "Get your first real drafts.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận những bản nháp thật đầu tiên."
          }
        }
      }
    },
    "Choose how Per My Last reaches Claude. You can change this any time in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn cách Per My Last kết nối với Claude. Bạn có thể đổi bất cứ lúc nào trong Cài đặt."
          }
        }
      }
    },
    "you@example.com": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "you@example.com"
          }
