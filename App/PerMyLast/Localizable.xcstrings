    "Email me a code": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi mã qua email"
          }
        }
      }
    },
    "I already have a Claude API key": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã có khóa API Claude"
          }
        }
      }
    },
    "Checking your key…": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kiểm tra khóa…"
          }
        }
      }
    },
    "Kept in your Mac's Keychain and only sent to Anthropic. You pay Anthropic directly.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
