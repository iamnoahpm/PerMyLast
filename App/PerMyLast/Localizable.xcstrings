    "Who this writing should land with — beginners, experts, children, and so on. Set per Tone Preset, not here.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai sẽ đọc nội dung này — người mới bắt đầu, chuyên gia, trẻ em, v.v. Thiết lập theo từng Tông giọng, không phải ở đây."
          }
        }
      }
    },
    "Custom Instructions": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dẫn tùy chỉnh"
          }
        }
      }
    },
    "Standing rules the AI should always follow when writing. Set per Tone Preset, not here.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các quy tắc cố định AI phải luôn tuân theo khi viết. Thiết lập theo từng Tông giọng, không phải ở đây."
          }
        }
      }
    },
    "— coming soon": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "— sắp ra mắt"
          }
