      }
    },
    "Say what you mean, but professionally. Saving careers, one email, one message at a time.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói điều bạn muốn nói, nhưng vẫn chuyên nghiệp. Cứu sự nghiệp, từng email, từng tin nhắn một."
          }
        }
      }
    },
