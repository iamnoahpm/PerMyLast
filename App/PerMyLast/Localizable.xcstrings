    },
    "Still not detected. If Per My Last is already switched on in the list, quit and reopen the app, then check again.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn chưa nhận được quyền. Nếu Per My Last đã được bật trong danh sách, hãy thoát và mở lại app, rồi kiểm tra lại."
          }
