            "state": "translated",
            "value": "Nói điều mới, chỉn chu"
          }
        }
      }
    },
    "Make sense of a message": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiểu một tin nhắn"
          }
        }
      }
    },
    "Get advice on tone or wording": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
