        }
      }
    },
    "Only needed if you see \"anthropic-workspace-id is required\" — that means your key is linked to your identity within an org, not a standalone workspace key.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cần điền nếu bạn thấy lỗi \"anthropic-workspace-id is required\" — nghĩa là khóa của bạn gắn với tài khoản cá nhân trong một tổ chức, không phải khóa workspace độc lập."
          }
        }
      }
    },
