          }
        }
      }
    },
    "Finish setup": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất thiết lập"
          }
        }
      }
    },
    "Click Allow access, then switch Per My Last on in the list that opens. Come back here after; we notice on our own.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm Allow access, rồi bật Per My Last trong danh sách vừa mở. Sau đó quay lại đây, app sẽ tự nhận ra."
          }
        }
      }
    },
    "Answer a message you got": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời một tin nhắn bạn nhận được"
          }
        }
      }
    },
    "Say something new, polished": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
